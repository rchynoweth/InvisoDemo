# Data backend: "mock" (default) or "fabric" (not implemented yet)
PORTAL_DATA_BACKEND=mock

# Local port the app listens on (also used by Docker/Azure Container Apps/App Service)
PORT=8050

# Flask session secret — set a real random value before any non-local use
SECRET_KEY=dev-secret-key-change-me

# Login credentials. Generate PORTAL_PASSWORD_HASH with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
PORTAL_USERNAME=admin
PORTAL_PASSWORD_HASH=

# --- Future Microsoft Fabric connection (not used until PORTAL_DATA_BACKEND=fabric) ---
# FABRIC_SQL_ENDPOINT=
# FABRIC_WAREHOUSE_NAME=
# FABRIC_TENANT_ID=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
